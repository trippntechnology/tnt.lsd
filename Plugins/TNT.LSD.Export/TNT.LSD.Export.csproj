<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>

		<!-- File Description -->
		<AssemblyTitle>Landscape Sprinkler Designer Exporter Plugin</AssemblyTitle>
		<Authors>Tripp'n Technology, LLC.</Authors>
		<Company>$(Authors)</Company>
		<Configurations>Debug;Release;Debug (PALETTE_PROPERTIES)</Configurations>
		<Copyright>Copyright 2024 $(Authors)</Copyright>
		<FileVersion>$(PackageVersion)</FileVersion>
		<GenerateDocumentationFile>False</GenerateDocumentationFile>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Product Name -->
		<Product>$(AssemblyTitle)</Product>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Version>2.0.0</Version>

	</PropertyGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="mkdir $(SolutionDir)LandscapeSprinklerDesigner\bin\Debug\net8.0-windows\plugins;&#xD;&#xA;copy $(TargetPath) $(SolutionDir)LandscapeSprinklerDesigner\bin\Debug\net8.0-windows\plugins;" />
	</Target>

	<ItemGroup>
	  <None Remove="Images\jpg.png" />
	  <None Remove="Images\png.png" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Images\jpg.png" />
	  <EmbeddedResource Include="Images\png.png" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Libraries\TNT.LSD.Components\TNT.LSD.Components.csproj" />
	  <ProjectReference Include="..\..\Libraries\TNT.LSD.Settings\TNT.LSD.Settings.csproj" />
	</ItemGroup>

</Project>
