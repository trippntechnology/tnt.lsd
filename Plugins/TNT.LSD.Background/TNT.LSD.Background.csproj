<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TargetFramework>net8.0-windows</TargetFramework>

		<AssemblyVersion>$(PackageVersion)</AssemblyVersion>
		<Authors>Tripp'n Technology, LLC.</Authors>
		<Company>$(Authors)</Company>
		<Copyright>Copyright 2024 $(Authors)</Copyright>
		<Description>Background Importer</Description>
		<FileVersion>$(PackageVersion)</FileVersion>
		<Title>Background Importer</Title>
		<Version>2.0.0</Version>

	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Images\import_background_image.png" />
	  <None Remove="Images\show_landscape.png" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Images\import_background_image.png" />
	  <EmbeddedResource Include="Images\show_landscape.png" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="TNT.Plugin.Manager" Version="2.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Libraries\TNT.LSD.Components\TNT.LSD.Components.csproj" />
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
	  <Exec Command="mkdir $(SolutionDir)LandscapeSprinklerDesigner\bin\Debug\plugins&#xD;&#xA;copy $(TargetPath) $(SolutionDir)LandscapeSprinklerDesigner\bin\Debug\plugins" />
	</Target>

</Project>
