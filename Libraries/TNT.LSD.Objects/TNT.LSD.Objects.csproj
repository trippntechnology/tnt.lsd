		<EmbeddedResource Include="Images\BezierControlPoint.png" />
		<EmbeddedResource Include="Images\CornerControlPoint.png" />
		<EmbeddedResource Include="Images\SideControlPoint.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="TNT.Math" Version="2.0.0" />
		<PackageReference Include="tnt.reflection" Version="2.0.0" />
		<PackageReference Include="TNT.Utilities" Version="3.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TNT.LSD.Inventory\TNT.LSD.Inventory.csproj" />
