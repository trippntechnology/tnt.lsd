		<EmbeddedResource Include="Cursors\No_MainPipe.cur" />
		<EmbeddedResource Include="Cursors\PolyLine.cur" />
		<EmbeddedResource Include="Cursors\Rectangle.cur" />
		<EmbeddedResource Include="Cursors\RemovePoint.cur" />
		<EmbeddedResource Include="Cursors\Rotate.cur" />
		<EmbeddedResource Include="Cursors\Select.cur" />
